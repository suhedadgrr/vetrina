---
import { about } from '@content/site';
---

<section class="section" id="biz-kimiz" aria-labelledby="biz-title">
  <div class="container about">
    <div class="about__photo reveal reveal--scale">
      <div class="photo glass" data-tilt>
        {about.founder.photo ? (
          <img
            src={about.founder.photo}
            alt={`${about.founder.name} — ${about.founder.role}`}
            width="640"
            height="800"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="photo__ph" role="img" aria-label={about.founder.name}>
            <span class="photo__mono" aria-hidden="true">
              {about.founder.initials}
            </span>
          </div>
        )}
        <div class="photo__cap">
          <strong class:list={[about.founder.name.includes('[') && 'placeholder-mark']}>
            {about.founder.name}
          </strong>
          <span>{about.founder.role}</span>
        </div>
      </div>
    </div>

    <div class="about__copy">
      <p class="eyebrow reveal">Biz kimiz</p>
      <h2 id="biz-title" class="reveal" style="--i:1">
        {about.title}
      </h2>
      {about.paragraphs.map((p, i) => (
        <p class="about__p reveal" style={`--i:${i + 2}`}>
          {p}
        </p>
      ))}
      {about.founder.portfolio && (
        <p class="about__p reveal" style="--i:5">
          <a href={about.founder.portfolio} target="_blank" rel="noopener">
            Kurucunun kişisel portföyü ↗
          </a>
        </p>
      )}
      <ul class="vals">
        {about.values.map((v, i) => (
          <li class="reveal" style={`--i:${i + 3}`}>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    padding: 0;
    transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.4s var(--ease-out);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--sp-3);
    background:
      radial-gradient(circle at 30% 20%, var(--glow-a), transparent 60%),
      radial-gradient(circle at 80% 90%, var(--glow-c), transparent 55%);
    padding: var(--sp-5);
    text-align: center;
  }
  .photo__mono {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(6rem, 18vw, 11rem);
    line-height: 1;
    background: linear-gradient(140deg, var(--text), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .photo__note {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    border-bottom: 1px dashed var(--warm);
  }
  .photo__cap {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--sp-5) var(--sp-4) var(--sp-4);
    display: grid;
    background: linear-gradient(transparent, rgba(5, 8, 24, 0.82));
    color: #fff;
  }
  .photo__cap span {
    font-size: var(--fs-sm);
    opacity: 0.85;
  }
  .about__copy {
    display: grid;
    gap: var(--sp-4);
  }
  .about__copy h2 {
    font-size: var(--fs-3xl);
  }
  .about__p {
    color: var(--text-muted);
    font-size: var(--fs-lg);
  }
  .vals {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
    margin-top: var(--sp-4);
  }
  .vals li {
    padding-top: var(--sp-3);
    border-top: 2px solid;
    border-image: linear-gradient(90deg, var(--c-violet), transparent) 1;
  }
  .vals h3 {
    font-size: var(--fs-base);
    font-family: var(--font-body);
    font-weight: 700;
    margin-bottom: 0.3rem;
  }
  .vals p {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__photo {
      max-width: 24rem;
    }
    .vals {
      grid-template-columns: 1fr;
    }
  }
</style>
