---
/** Yatay logo (işaret + yazı). Yazı rengi currentColor: temaya göre değişir. */
import { WORD_PATH, WORD_TRANSFORM, LOGO_VIEWBOX, LOGO_RATIO } from '@lib/wordmark';
interface Props {
  height?: number;
  class?: string;
}
const { height = 34, class: cls } = Astro.props;
const w = Math.round(height * LOGO_RATIO);
---

<svg class={cls} viewBox={LOGO_VIEWBOX} width={w} height={height} role="img" aria-label="Vetrina">
  <g transform="translate(3.2 6.4) scale(0.8)">
    <defs>
      <linearGradient id="lgl" x1="4" y1="8" x2="32" y2="56" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#A196FF" />
        <stop offset="1" stop-color="#5A48F5" />
      </linearGradient>
      <linearGradient id="lgr" x1="60" y1="8" x2="32" y2="56" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#6EA0FF" />
        <stop offset="1" stop-color="#2458EE" />
      </linearGradient>
    </defs>
    <path fill="url(#lgl)" d="M4 8H22L32 36V56H23Z" />
    <path fill="url(#lgr)" d="M32 36 42 8H45.5L52.2 28.6 41 56H32Z" />
    <path fill="#FFB84D" d="M45.5 8H60L52.2 28.6Z" />
  </g>
  <path transform={WORD_TRANSFORM} fill="currentColor" d={WORD_PATH} />
</svg>
