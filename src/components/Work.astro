---
import { works } from '@content/work';
import { href } from '@lib/url';
import Icon from './Icon.astro';
import ConceptArt from './ConceptArt.astro';
import BeforeAfter from './BeforeAfter.astro';
// Ana sayfada ilk 4 çalışma (gerçek vaka + 3 konsept); tamamı /calismalar/ sayfasında.
const featured = works.slice(0, 4);
---

<section class="section" id="calismalar" aria-labelledby="calismalar-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow reveal">Seçilmiş çalışmalar</p>
      <h2 id="calismalar-title" class="reveal" style="--i:1">
        Gerçek bir vaka, <span class="grad-text">gerçek standart</span>.
      </h2>
      <p class="reveal" style="--i:2">
        İlk gerçek işimiz bir diş kliniğinin dijital altyapısı (müşterinin izniyle). Diğerleri,
        kurgusal markalar için hazırladığımız ve yaklaşımımızı gösteren{' '}
        <strong>konsept çalışmalardır</strong>; etiketlerinden ayırt edebilirsiniz.
      </p>
    </header>

    <ul class="work-grid">
      {featured.map((w, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <a
            class="work-card glass"
            href={href(`/calismalar/${w.slug}/`)}
            data-work-open={w.slug}
            data-tilt
            data-track="work_open"
            data-track-where={w.slug}
            aria-label={`${w.brand} — ${w.category}, ayrıntıyı aç`}
          >
            <div class="work-card__art">
              <ConceptArt work={w} ratio={i % 3 === 0 ? '4 / 5' : '1 / 1'} animated={false} />
              {w.previewVideo && (
                <video
                  class="work-card__video"
                  muted
                  loop
                  playsinline
                  preload="none"
                  data-src={w.previewVideo}
                  aria-hidden="true"
                  tabindex="-1"
                ></video>
              )}
              <span class="work-card__play" aria-hidden="true">
                <Icon name="motion" size={16} /> Önizle
              </span>
            </div>
            <div class="work-card__meta">
              <div>
                <h3>{w.brand}</h3>
                <p>{w.category}</p>
              </div>
              <span class="work-card__go" aria-hidden="true">
                <Icon name="arrow" size={18} />
              </span>
            </div>
            <ul class="tags" aria-label="Hizmetler">
              {w.services.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </a>
        </li>
      ))}
    </ul>

    <div class="ba-wrap reveal">
      <header class="ba-head">
        <h3>Önce / Sonra</h3>
        <p>
          Kaydırıcıyı sürükleyin: aynı markanın şablon görünümü ile Vetrina yaklaşımı.{' '}
          <em>(Kurgusal örnekler)</em>
        </p>
      </header>
      <BeforeAfter />
    </div>

    <p class="work-more reveal">
      <a class="btn btn--ghost" href={href('/calismalar/')}>
        Tüm çalışmalar <Icon name="arrow" class="arrow" />
      </a>
    </p>
  </div>

  {featured.map((w) => (
    <dialog
      class="modal"
      id={`modal-${w.slug}`}
      aria-labelledby={`m-${w.slug}-t`}
      data-work-modal={w.slug}
    >
      <button class="modal__close icon-x" type="button" data-modal-close aria-label="Kapat">
        <Icon name="close" size={22} />
      </button>
      <div class="modal__box glass">
        <div class="modal__art">
          <ConceptArt work={w} ratio="4 / 5" animated={true} />
        </div>
        <div class="modal__body">
          <p class="eyebrow">{w.concept ? 'Konsept çalışma' : 'Vaka'}</p>
          <h3 id={`m-${w.slug}-t`}>{w.brand}</h3>
          <p class="modal__cat">
            {w.category} · {w.services.join(' · ')}
          </p>
          <dl>
            <dt>Zorluk</dt>
            <dd>{w.challenge}</dd>
            <dt>Yaklaşım</dt>
            <dd>{w.approach}</dd>
            <dt>{w.concept ? 'Hedef sonuç' : 'Teslim edilenler'}</dt>
            <dd>{w.result}</dd>
          </dl>
          <div class="modal__actions">
            <a
              class="btn btn--primary btn--sm"
              href={href('/#iletisim')}
              data-modal-close
              data-track="cta_click"
              data-track-where={`modal-${w.slug}`}
              data-prefill={w.services[0]}
            >
              Benzer bir çalışma isteyin
            </a>
            <a class="btn btn--ghost btn--sm" href={href(`/calismalar/${w.slug}/`)}>
              Vaka sayfası
            </a>
          </div>
        </div>
      </div>
    </dialog>
  ))}
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--sp-5);
    align-items: start;
  }
  .work-grid > li {
    grid-column: span 6;
  }
  .work-grid > li:nth-child(1) {
    grid-column: span 5;
  }
  .work-grid > li:nth-child(2) {
    grid-column: span 7;
  }
  .work-grid > li:nth-child(3) {
    grid-column: span 7;
  }
  .work-grid > li:nth-child(4) {
    grid-column: span 5;
  }
  .work-card {
    display: grid;
    gap: var(--sp-4);
    padding: var(--sp-3);
    transform: perspective(1000px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.35s var(--ease-out),
      border-color var(--dur-2);
  }
  .work-card:hover {
    border-color: var(--accent);
  }
  .work-card__art {
    position: relative;
    border-radius: calc(var(--r-lg) - 6px);
    overflow: hidden;
  }
  .work-card__art :global(.art) {
    transition: transform 0.9s var(--ease-out);
  }
  .work-card:hover .work-card__art :global(.art) {
    transform: scale(1.04);
  }
  .work-card__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-2);
    z-index: 3;
  }
  .work-card:hover .work-card__video {
    opacity: 1;
  }
  .work-card__play {
    position: absolute;
    left: 0.8rem;
    bottom: 0.8rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--r-pill);
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    opacity: 0;
    transform: translateY(6px);
    transition: all var(--dur-2) var(--ease-out);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .work-card:hover .work-card__play,
  .work-card:focus-visible .work-card__play {
    opacity: 1;
    transform: none;
  }
  .work-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
    padding: 0 var(--sp-3);
  }
  .work-card h3 {
    font-size: var(--fs-xl);
  }
  .work-card__meta p {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
  .work-card__go {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    transition: all var(--dur-2) var(--ease-out);
  }
  .work-card:hover .work-card__go {
    background: linear-gradient(120deg, var(--btn-from), var(--btn-to));
    color: #fff;
    transform: rotate(-45deg);
    border-color: transparent;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0 var(--sp-3) var(--sp-3);
  }
  .tags li {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    color: var(--text-muted);
  }

  .ba-wrap {
    margin-top: clamp(3rem, 7vw, 6rem);
  }
  .ba-head {
    margin-bottom: var(--sp-5);
  }
  .ba-head h3 {
    font-size: var(--fs-2xl);
    margin-bottom: var(--sp-2);
  }
  .ba-head p {
    color: var(--text-muted);
    max-width: 40rem;
  }
  .work-more {
    margin-top: var(--sp-7);
    text-align: center;
  }

  /* Modal */
  .modal {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--text);
    max-width: min(62rem, calc(100% - 1.5rem));
    width: 100%;
    max-height: calc(100dvh - 1.5rem);
    overflow: visible;
    margin: auto;
  }
  .modal::backdrop {
    background: rgba(4, 7, 22, 0.72);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .modal[open] {
    animation: modal-in 0.5s var(--ease-out);
  }
  .modal[open]::backdrop {
    animation: fade 0.4s;
  }
  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.97);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .modal__box {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--sp-5);
    padding: var(--sp-4);
    background: var(--glass-strong);
    max-height: calc(100dvh - 1.5rem);
    overflow: auto;
  }
  .modal__art {
    border-radius: var(--r-md);
    overflow: hidden;
    align-self: start;
  }
  .modal__body {
    padding: var(--sp-4) var(--sp-4) var(--sp-4) 0;
    display: grid;
    gap: var(--sp-3);
    align-content: start;
  }
  .modal__body h3 {
    font-size: var(--fs-2xl);
  }
  .modal__cat {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
  .modal dl {
    display: grid;
    gap: 0.2rem;
    margin: var(--sp-2) 0;
  }
  .modal dt {
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
    margin-top: var(--sp-3);
  }
  .modal dd {
    margin: 0;
    color: var(--text-muted);
  }
  .modal__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
  }
  .modal__close {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    z-index: 6;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background: var(--glass-strong);
  }
  .modal__close:hover {
    border-color: var(--accent);
  }

  @media (max-width: 960px) {
    .work-grid > li:nth-child(n) {
      grid-column: span 6;
    }
  }
  @media (max-width: 720px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
    .work-grid > li:nth-child(n) {
      grid-column: 1;
    }
    .modal__box {
      grid-template-columns: 1fr;
    }
    .modal__body {
      padding: 0 var(--sp-2) var(--sp-3);
    }
    .modal__art {
      max-width: 20rem;
    }
    .work-card__play {
      opacity: 1;
      transform: none;
    }
  }
</style>
