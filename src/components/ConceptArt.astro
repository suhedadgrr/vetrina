---
/**
 * Özgün, kod ile üretilmiş marka görseli (stok görsel yok). Kurgusal konsept markalar için.
 * Sabit en-boy oranlı bir kutu; `ratio` ile ayarlanır.
 */
import type { Work } from '@content/work';
interface Props {
  work: Work;
  ratio?: string;
  animated?: boolean;
  label?: boolean;
  style?: 'after' | 'before';
}
const { work, ratio = '4 / 5', animated = true, label = true, style = 'after' } = Astro.props;
const { palette: p, pattern, brand } = work;
---

<div
  class:list={['art', `art--${pattern}`, `art--${style}`, animated && 'is-animated']}
  style={`--bg:${p.bg};--fg:${p.fg};--a:${p.a};--b:${p.b};aspect-ratio:${ratio}`}
  role="img"
  aria-label={`${brand} konsept görseli`}
>
  {style === 'after' ? (
    <>
      <svg
        class="art__pattern"
        viewBox="0 0 400 500"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        {pattern === 'grid' && (
          <g stroke="currentColor" stroke-opacity=".28" fill="none" stroke-width="1.2">
            {Array.from({ length: 9 }, (_, i) => (
              <path d={`M${i * 50} 0V500`} />
            ))}
            {Array.from({ length: 11 }, (_, i) => (
              <path d={`M0 ${i * 50}H400`} />
            ))}
            <circle cx="260" cy="190" r="110" stroke-opacity=".7" />
            <circle cx="260" cy="190" r="60" stroke-opacity=".7" />
            <path d="M150 190h220M260 80v220" stroke-opacity=".7" />
          </g>
        )}
        {pattern === 'orbit' && (
          <g fill="none" stroke="currentColor" stroke-opacity=".4" stroke-width="1.4">
            <ellipse cx="200" cy="210" rx="170" ry="70" transform="rotate(-20 200 210)" />
            <ellipse cx="200" cy="210" rx="130" ry="50" transform="rotate(25 200 210)" />
            <circle cx="200" cy="210" r="70" stroke-opacity=".8" />
            <circle class="dot" cx="330" cy="150" r="9" fill="var(--b)" stroke="none" />
          </g>
        )}
        {pattern === 'stripes' && (
          <g stroke="currentColor" stroke-opacity=".35" fill="none" stroke-width="1.4">
            {Array.from({ length: 12 }, (_, i) => (
              <path
                d={`M-20 ${60 + i * 34} C 120 ${i * 34 - 20}, 260 ${120 + i * 30}, 420 ${40 + i * 34}`}
              />
            ))}
          </g>
        )}
        {pattern === 'wave' && (
          <g fill="none" stroke="currentColor" stroke-opacity=".4" stroke-width="1.4">
            {Array.from({ length: 9 }, (_, i) => (
              <path d={`M-10 ${110 + i * 26} q 50 -40 100 0 t 100 0 t 100 0 t 100 0 t 100 0`} />
            ))}
          </g>
        )}
      </svg>
      <span class="art__blob art__blob--a" aria-hidden="true"></span>
      <span class="art__blob art__blob--b" aria-hidden="true"></span>
      <div class="art__content">
        <span class="art__mark" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
        <p class="art__cat">{work.category}</p>
        <p class="art__brand">{brand}</p>
        <p class="art__tag">{work.tagline}</p>
      </div>
      {label && <span class="art__badge">{work.concept ? 'Konsept çalışma' : 'Proje'}</span>}
    </>
  ) : (
    <div class="art__content art__content--plain">
      <p class="art__brand art__brand--plain">{brand}</p>
      <p class="art__plain-tag">hizmet · kalite · güven</p>
      <span class="art__plain-line"></span>
      <span class="art__plain-line art__plain-line--s"></span>
      <span class="art__plain-btn">Detaylı bilgi</span>
      {label && <span class="art__badge art__badge--before">Önce (kurgusal)</span>}
    </div>
  )}
</div>

<style>
  .art {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: inherit;
    background: var(--bg);
    color: var(--fg);
    isolation: isolate;
    container-type: size;
  }
  .art__pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--fg);
    z-index: 0;
  }
  .art__blob {
    position: absolute;
    z-index: 0;
    border-radius: 50%;
    will-change: transform;
  }
  .art__blob--a {
    width: 70%;
    aspect-ratio: 1;
    right: -18%;
    top: -14%;
    background: radial-gradient(circle at 35% 35%, var(--a), transparent 68%);
    opacity: 0.85;
  }
  .art__blob--b {
    width: 62%;
    aspect-ratio: 1;
    left: -18%;
    bottom: -16%;
    background: radial-gradient(circle at 60% 60%, var(--b), transparent 68%);
    opacity: 0.55;
  }
  :global(.work-card:hover) .art__blob--a,
  .is-animated .art__blob--a {
    animation: drift-a 14s ease-in-out infinite alternate;
  }
  :global(.work-card:hover) .art__blob--b,
  .is-animated .art__blob--b {
    animation: drift-b 17s ease-in-out infinite alternate;
  }
  :global(.work-card:hover) .art__pattern,
  .is-animated .art__pattern {
    animation: pat 24s linear infinite alternate;
  }
  @keyframes drift-a {
    to {
      transform: translate(-12%, 16%) scale(1.12);
    }
  }
  @keyframes drift-b {
    to {
      transform: translate(14%, -12%) scale(1.1);
    }
  }
  @keyframes pat {
    to {
      transform: scale(1.06) rotate(1deg);
    }
  }
  .art__content {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 8cqmin;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.2cqmin;
  }
  .art__mark {
    position: absolute;
    top: 8cqmin;
    left: 8cqmin;
    width: 9cqmin;
    height: 9cqmin;
    border-radius: 28%;
    background: var(--fg);
    display: grid;
    place-items: center;
  }
  .art__mark i {
    grid-area: 1/1;
    width: 46%;
    height: 46%;
    border-radius: 50%;
    background: var(--bg);
  }
  .art__mark i:last-child {
    width: 22%;
    height: 22%;
    background: var(--a);
    transform: translate(60%, -60%);
  }
  .art__cat {
    font-size: 3.4cqmin;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
    font-weight: 600;
  }
  .art__brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 13cqmin;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .art__tag {
    font-size: 4cqmin;
    line-height: 1.35;
    max-width: 26ch;
    opacity: 0.9;
  }
  .art__badge {
    position: absolute;
    z-index: 2;
    top: 6cqmin;
    right: 6cqmin;
    font-size: 2.9cqmin;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 1.2cqmin 3cqmin;
    border-radius: 99px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  /* "Önce" hali: bilinçli olarak sıradan, şablon gibi */
  .art--before {
    background: #e9ecef;
    color: #2b2f36;
  }
  .art__content--plain {
    justify-content: center;
    align-items: flex-start;
    gap: 3cqmin;
    font-family: Arial, Helvetica, sans-serif;
  }
  .art__brand--plain {
    font-family: 'Times New Roman', serif;
    font-size: 11cqmin;
    letter-spacing: 0;
    font-weight: 700;
    color: #1a3a73;
    text-shadow: 1px 1px 0 #fff;
  }
  .art__plain-tag {
    font-size: 4cqmin;
    color: #4f535c;
  }
  .art__plain-line {
    width: 80%;
    height: 2.4cqmin;
    background: #cfd3da;
    border-radius: 2px;
  }
  .art__plain-line--s {
    width: 55%;
  }
  .art__plain-btn {
    margin-top: 2cqmin;
    padding: 2cqmin 5cqmin;
    font-size: 3.6cqmin;
    background: #1a3a73;
    color: #fff;
    border-radius: 2px;
  }
  .art__badge--before {
    background: #ffffffcc;
    color: #444;
    border-color: #bbb;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.work-card:hover) .art__blob--a,
    :global(.work-card:hover) .art__blob--b,
    :global(.work-card:hover) .art__pattern,
    .is-animated .art__blob,
    .is-animated .art__pattern {
      animation: none;
    }
  }
</style>
